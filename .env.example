# PostgreSQL connection string. Used by Prisma runtime and migrations.
#
# Local dev target (no Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primal_creator?schema=public"
#
# Inside `docker compose` the app container overrides DATABASE_URL to point at the
# compose `postgres` service, so this value is only used for local `pnpm dev`.

# JWT signing secret for auth cookies. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
#
# Required for `docker compose up` (compose fails fast if unset).
AUTH_SECRET="please-change-me-this-is-a-development-secret-32chars"

# Bootstrap admin credentials used by `pnpm db:seed`. Never commit real secrets;
# override in a local, git-ignored env file or the deployment secret store.
#
# The password below is a DEV placeholder only. In production (`NODE_ENV=
# production`, e.g. the compose stack) the seed refuses 'admin', 'password', and
# other placeholder values, and requires >= 12 characters. The compose stack also
# requires ADMIN_PASSWORD to be set (no default fallback).
ADMIN_EMAIL="admin@primal.local"
ADMIN_PASSWORD="admin"
ADMIN_NAME="Admin"

# Whether the catalog endpoints are publicly viewable without a session.
# Default false: catalog reads require an authenticated session.
CATALOG_PUBLIC="false"

# Runtime environment: development sets the session cookie to non-secure.
NODE_ENV="development"

# The public browser origin the app is served from, e.g. "https://example.com".
# Optional, but REQUIRED when the app is deployed behind a reverse proxy: the
# request the app sees has a proxy origin (Host), not the browser origin, so the
# CSRF same-origin check (which compares `Origin` against APP_ORIGIN, falling back
# to `new URL(req.url).origin`) must be told the real origin. Set only the scheme +
# host + optional port, no path, no trailing slash: "https://app.example.com".
#
# In production always use HTTPS. When unset, the app compares `Origin` against
# the request's own origin, which is correct for a direct (non-proxied) deploy.
# APP_ORIGIN="https://app.example.com"

# Private directory for uploaded portrait binaries (character avatars). Files
# here are not on the public filesystem - they are streamed back through the
# authenticated /api/assets/[id] route. Default in production is /app/data/
# uploads (the compose `uploads` volume); outside production it defaults to
# <cwd>/data/uploads. Optional: leave unset to use the default.
# UPLOAD_DIR="/app/data/uploads"

# ---- Compose-only overrides (primal-creator) ----
# These only affect the Compose stack; they are ignored by plain `pnpm dev`.
#
# POSTGRES_PASSWORD is REQUIRED by `docker compose` (compose fails fast if unset;
# there is no fallback), and the default shown below is a DEV-ONLY placeholder.
# If you expose the Postgres port or run Postgres on a network-facing service,
# set a real password - never rely on the known default `postgres`.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="primal_creator"

# Host port the app container publishes on (compose maps APP_PORT:3000).
APP_PORT="3000"

# Image tag used when the compose `app` service is not built locally.
DOCKER_TAG="latest"

# ---- Real-Postgres integration tests ----
# lib/db/user-service.pg.test.ts and app/api/characters/[id]/portrait/route.test.ts
# touch a live database. They run ONLY when both hold:
#   - RUN_DB_INTEGRATION_TESTS is "1", and
#   - the effective Prisma DATABASE_URL names a test database (name contains
#     `_test` or `test_`). An ordinary `pnpm test` against the dev DB therefore
#     skips them - never demoting an existing admin or broadly deleting users.
#
# TEST_DATABASE_URL, when set, is the isolated test DB and also becomes the
# effective Prisma DATABASE_URL for the test run (set before the Prisma singleton
# is constructed). Prefer TEST_DATABASE_URL over pointing DATABASE_URL at a
# non-test database.
#
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primal_creator_test?schema=public"
# RUN_DB_INTEGRATION_TESTS="1"
