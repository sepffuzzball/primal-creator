{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "primal-catalog": {
        "type": "local",
        "command": [
          "pnpm",
          "mcp:catalog"
        ],
        "environment": {
          "PRIMAL_CATALOG_URL": "https://primalcreator.fuzzball.enterprises",
          "PRIMAL_CATALOG_TOKEN": "{env:PRIMAL_CATALOG_TOKEN}"
        },
        "disabled": false
      }
    }
  }
}
