// Prisma schema for primal-creator.
//
// Persistence for the deterministic progression engine. The engine itself is a
// pure TypeScript module (lib/rules) and stores its full CharacterState as a
// JSON blob on Character.state. This schema adds identity, ownership, optimistic
// concurrency, an immutable event journal, and a polymorphic catalog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ //
// Enums
// ------------------------------------------------------------------ //

enum Origin {
  integrated
  born
}

enum CatalogKind {
  races
  classes
  professions
  titles
  equipment
  skills
  blessings
  bloodlines
  consumables
  evolutions
  gods
}

enum Provenance {
  verified
  inferred
  house
}

enum AssociationKind {
  TITLE
  EQUIPMENT
  SKILL
  BLESSING
  BLOODLINE
}

// ------------------------------------------------------------------ //
// Users
// ------------------------------------------------------------------ //

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  // bcrypt hash; never plaintext. Seeded from ADMIN_EMAIL / ADMIN_PASSWORD.
  password  String
  isAdmin   Boolean     @default(false)
  // When true the user cannot sign in; existing sessions are revoked because
  // verifySessionToken rejects disabled users on every request.
  disabled  Boolean     @default(false)
  // Session-revocation counter. Any role/disable/password change increments this;
  // a JWT carrying an older `sessionVersion` is rejected, so a password reset or
  // role change invalidates all previously issued tokens immediately.
  sessionVersion Int    @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  characters Character[]
  draft     CharacterDraft?

  @@map("users")
}

// ------------------------------------------------------------------ //
// Assets (metadata only; the binary is stored elsewhere)
// ------------------------------------------------------------------ //

model Asset {
  id         String    @id @default(cuid())
  // e.g. "character-avatar", "catalog-image", "journal-attachment".
  kind       String
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  url        String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  character  Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String?

  @@index([kind])
  @@map("assets")
}

// ------------------------------------------------------------------ //
// Character creation drafts (resumable, per-user)
// ------------------------------------------------------------------ //
//
// A draft is a resumable character-creation snapshot persisted per authenticated
// user. It is NOT authoritative character state: the final Character row (and its
// engine state) is created by the existing createCharacter flow, which is a
// separate operation and, like every character mutation, runs in its own
// transaction. A draft is at most one per user (`@@unique([userId])`), stores only
// validated draft `data` (JSON, no uploaded binaries, no stat/award/effect
// fields), and is optimistic-concurrency (CAS) versioned so a stale write never
// silently overwrites a newer draft.

model CharacterDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Validated draft payload (see lib/server/draft-schema.ts). Never authoritative
  // character state; the engine CharacterState is derived only when the draft is
  // turned into a Character.
  data      Json
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("character_drafts")
}

// ------------------------------------------------------------------ //
// Characters
// ------------------------------------------------------------------ //

model Character {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  origin        Origin   @default(integrated)
  // Optional relations to catalog definitions. Null means "not yet chosen".
  raceId        String?
  classId       String?
  professionId  String?
  race          CatalogDefinition? @relation("CharacterRace", fields: [raceId], references: [id])
  class         CatalogDefinition? @relation("CharacterClass", fields: [classId], references: [id])
  profession    CatalogDefinition? @relation("CharacterProfession", fields: [professionId], references: [id])

  // Full engine state, serialized as JSON. Represents `CharacterState`.
  state         Json
  // Optimistic concurrency token. Every mutation must present the current value
  // via the `version` field; a mismatch is a 409 conflict.
  version       Int      @default(0)
  archived      Boolean  @default(false)
  // True when this character was created from a user-supplied trusted-backup
  // JSON import (POST /api/characters/import). Distinguishes server-verified
  // progression from untrusted imported history.
  imported      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        ProgressionEvent[]
  assets        Asset[]
  associations  CharacterAssociation[]
  skillOffers   SkillOffer[]

  @@index([ownerId])
  @@index([archived])
  @@index([ownerId, archived])
  @@map("characters")
}

// Immutable journal of progression events. Append-only: a row is never updated
// or deleted. Every state mutation persists one of these.
model ProgressionEvent {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // "create" | "update" | "advance" | "allocate" | "evolve" | "archive" | ...
  kind        String
  // Immutable payload; never mutated after insert.
  payload     Json
  createdAt   DateTime  @default(now())

  @@index([characterId, createdAt])
  @@map("progression_events")
}

// ------------------------------------------------------------------ //
// Polymorphic catalog
// ------------------------------------------------------------------ //
//
// A single table holds every kind of catalog entry keyed by `kind` + `stableId`.
// `config` carries kind-specific validated JSON (per-kind Zod schema on the
// server). `grade` is the grade band the entry belongs to (G/F/E/D/C/B/A/S);
// arbitrary entries may leave it null. `provenance` distinguishes verified wiki
// facts from inferred/house placeholders so nothing is presented as canon.

model CatalogDefinition {
  id          String      @id @default(cuid())
  kind        CatalogKind
  stableId    String
  name        String
  description String?
  grade       String?
  provenance  Provenance  @default(house)
  sourceUrl   String?
  archived    Boolean     @default(false)
  config      Json        @default("{}")
  // The patron god for a `blessings` entry. Set only when the blessing config
  // declares a `patronGodStableId`; the FK is resolved to the matching unarchived
  // `gods` definition so the JSON stableId and the FK never diverge. RESTRICT
  // because a referenced god is never deleted (its stableId must not change while
  // any blessing references it - see updateCatalogItem).
  patronId    String?
  patron      CatalogDefinition? @relation("CatalogPatron", fields: [patronId], references: [id], onDelete: Restrict)
  // Reverse relation: the `blessings` entries that name this definition as patron.
  patronFor   CatalogDefinition[] @relation("CatalogPatron")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  raceCharacters      Character[] @relation("CharacterRace")
  classCharacters     Character[] @relation("CharacterClass")
  professionCharacters Character[] @relation("CharacterProfession")
  characterAssociations CharacterAssociation[] @relation("AssociationDefinition")
  skillOfferOptions   SkillOfferOption[] @relation("SkillOfferOptionDefinition")
  skillOfferSelections SkillOffer[] @relation("SkillOfferSelection")

  @@unique([kind, stableId])
  @@index([kind])
  @@index([kind, archived])
  @@index([patronId])
  @@map("catalog_definitions")
}

// ------------------------------------------------------------------ //
// Character associations (titles / equipment)
// ------------------------------------------------------------------ //
//
// A link between a saved character and a catalog definition. Titles and
// equipment are NOT stored in Character.state; they are referenced here and
// synthesized into the live status at read time from the current (unedited)
// catalog config. History (Character.state and the event journal) stays
// immutable, so catalog edits recalculate live effects without rewriting
// historical awards.
//
// - `kind` TITLE or EQUIPMENT. Only one link per (character, definition).
// - Deleting a character cascades to its links. Deleting a catalog definition
//   that is referenced is RESTRICTed (a referenced definition is never removed).

model CharacterAssociation {
  id           String          @id @default(cuid())
  characterId  String
  character    Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definitionId String
  definition   CatalogDefinition @relation("AssociationDefinition", fields: [definitionId], references: [id], onDelete: Restrict)
  kind         AssociationKind
  createdAt    DateTime        @default(now())

  @@unique([characterId, definitionId])
  @@index([characterId])
  @@index([kind])
  @@map("character_associations")
}

// ------------------------------------------------------------------ //
// Skill offers (offered milestone choices, not automatic awards)
// ------------------------------------------------------------------ //
//
// Skills are acquired by explicit selection from a milestone offer, never by
// automatic award. When a character levels a class/profession track, the service
// queries the unarchived skills catalog and creates AT MOST ONE offer per choice
// group. Each offer carries read-only option snapshots (name + config) so a later
// catalog edit never rewrites what the character was actually offered. Selecting
// an option links the skill as a CharacterAssociation (kind SKILL), stamps the
// offer as selected, and the live state synthesizes the skill's passive effects
// from the CURRENT catalog config (history stays immutable).

model SkillOffer {
  id                   String             @id @default(cuid())
  characterId          String
  character            Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // The advancing track the offer was generated for: "class" or "profession".
  track                String
  // The track level reached at the time the offer was generated.
  level                Int
  // Choice group the offered options share ("standard" when none is configured).
  choiceGroup          String
  // The option the character selected. Null while the offer is still pending.
  selectedDefinitionId String?
  selectedDefinition   CatalogDefinition? @relation("SkillOfferSelection", fields: [selectedDefinitionId], references: [id], onDelete: Restrict)
  offeredAt            DateTime           @default(now())
  // Set only when an option is selected (atomic with the link + event).
  selectedAt           DateTime?
  options              SkillOfferOption[]

  @@unique([characterId, track, level, choiceGroup])
  @@index([characterId])
  @@index([track, level])
  @@map("skill_offers")
}

model SkillOfferOption {
  id             String            @id @default(cuid())
  offerId        String
  offer          SkillOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  definitionId   String
  definition     CatalogDefinition @relation("SkillOfferOptionDefinition", fields: [definitionId], references: [id], onDelete: Restrict)
  // Immutable snapshots captured when the offer was generated; the definition may
  // later be edited, but the character was offered THIS config.
  nameSnapshot   String
  configSnapshot Json

  @@unique([offerId, definitionId])
  @@index([offerId])
  @@index([definitionId])
  @@map("skill_offer_options")
}

// ------------------------------------------------------------------ //
// Server-wide house rules (singleton, admin-editable)
// ------------------------------------------------------------------ //
//
// A SINGLE row (`id = 'active'`) holds the validated, admin-editable house-rule
// defaults for the calculation engine: the equipment cap percentages and the
// consumable grade rates. It is layered on top of the engine defaults by
// `buildRulesConfig` (lib/db/service.ts) - it never rewrites historical awards.
//
// The row is seeded DURING the migration (0007_house_rules), never by the seed
// script, so the app never silently falls back to an in-memory default. `config`
// is validated server-side by `houseRulesConfigSchema` (lib/db/ruleset.ts);
// `version` is the optimistic-concurrency token for the admin Settings form
// (a stale PATCH is a 409). The `updatedAt` is surfaced to the admin so they know
// whether they are editing a fresh snapshot.
//
// PATCH semantics: updateMany({ where: { id: 'active', version } }) with
// `version: { increment: 1 }`. A missing row is an explicit 503, never a silent
// default.

model HouseRules {
  id        String   @id
  version   Int      @default(0)
  // Validated shape from `houseRulesConfigSchema`:
  // { equipmentIndividualCapPercent, equipmentCombinedCapPercent,
  //   consumableGradeRates: { F, E, D, C } }.
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("house_rules")
}
